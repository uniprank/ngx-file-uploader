{
    "name": "ngx-file-uploader",
    "version": "6.0.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --project=TestCases",
        "build": "ng build @uniprank/ngx-file-uploader",
        "build:demo": "ng build TestCases --base-href /ngx-file-uploader/",
        "test": "ng test @uniprank/ngx-file-uploader",
        "start:server": "cd server && npm run start:dev",
        "start:all": "npm run start & npm run start:server",
        "lint": "ng lint",
        "release:publish": "rm -rf dist/ngx-file-uploader && npm run build && cd dist/ngx-file-uploader && npm publish --access public",
        "version": "npm pkg set version=$npm_package_version --prefix library/ngx-file-uploader && git add library/ngx-file-uploader/package.json",
        "release:major": "npm version major && git push origin && git push origin --tags",
        "release:minor": "npm version minor && git push origin && git push origin --tags",
        "release:patch": "npm version patch && git push origin && git push origin --tags"
    },
    "private": false,
    "dependencies": {
        "@angular/animations": "~19.2.0",
        "@angular/common": "~19.2.0",
        "@angular/compiler": "~19.2.0",
        "@angular/core": "~19.2.0",
        "@angular/forms": "~19.2.0",
        "@angular/platform-browser": "~19.2.0",
        "@angular/platform-browser-dynamic": "~19.2.0",
        "@angular/router": "~19.2.0",
        "github-markdown-css": "^5.5.0",
        "marked": "^15.0.0",
        "ngx-markdown": "^19.0.0",
        "prism-themes": "^1.9.0",
        "prismjs": "^1.29.0",
        "rxjs": "~7.8.1",
        "tslib": "^2.6.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "~19.2.0",
        "@angular/cli": "~21.2.0",
        "@angular/compiler-cli": "~19.2.0",
        "@eslint/js": "^9.39.3",
        "@tailwindcss/postcss": "^4.2.1",
        "@types/jasmine": "~5.1.0",
        "@types/node": "^20.0.0",
        "@web/test-runner": "^0.20.0",
        "angular-eslint": "~19.1.0",
        "autoprefixer": "^10.4.27",
        "eslint": "^9.39.3",
        "jasmine-core": "~5.5.0",
        "ng-packagr": "~19.2.0",
        "postcss": "^8.5.8",
        "tailwindcss": "^4.2.1",
        "typescript": "~5.7.0",
        "typescript-eslint": "^8.56.1"
    }
}
