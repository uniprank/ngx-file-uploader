{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "library",
    "projects": {
        "@uniprank/ngx-file-uploader": {
            "projectType": "library",
            "root": "library/ngx-file-uploader",
            "sourceRoot": "library/ngx-file-uploader/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "library/ngx-file-uploader/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "library/ngx-file-uploader/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "library/ngx-file-uploader/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:web-test-runner",
                    "options": {
                        "tsConfig": "library/ngx-file-uploader/tsconfig.spec.json",
                        "polyfills": ["zone.js", "zone.js/testing"],
                        "include": ["library/ngx-file-uploader/src/**/*.spec.ts"]
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "library/ngx-file-uploader/**/*.ts",
                            "library/ngx-file-uploader/**/*.html"
                        ]
                    }
                }
            }
        },
        "TestCases": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "library/TestCases",
            "sourceRoot": "library/TestCases/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": "dist/test-cases",
                        "index": "library/TestCases/src/index.html",
                        "browser": "library/TestCases/src/main.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "library/TestCases/tsconfig.app.json",
                        "assets": [
                            "library/TestCases/src/favicon.ico",
                            "library/TestCases/src/assets",
                            {
                                "glob": "404.html",
                                "input": "library/TestCases/src/",
                                "output": "./"
                            },
                            {
                                "glob": "**/README.md",
                                "input": "library/TestCases/src/app/modules/",
                                "output": "./assets/docs/"
                            }
                        ],
                        "styles": [
                            "library/TestCases/src/tailwind.css",
                            "library/TestCases/src/styles.scss",
                            "node_modules/github-markdown-css/github-markdown.css",
                            "node_modules/prism-themes/themes/prism-dracula.css"
                        ],
                        "scripts": [
                            "node_modules/prismjs/prism.js",
                            "node_modules/prismjs/components/prism-typescript.min.js",
                            "node_modules/prismjs/components/prism-css.min.js",
                            "node_modules/prismjs/components/prism-shell-session.min.js"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "16kb",
                                    "maximumError": "20kb"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "library/TestCases/**/*.ts",
                            "library/TestCases/**/*.html"
                        ]
                    }
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "TestCases:build:production"
                        },
                        "development": {
                            "buildTarget": "TestCases:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    }
}
